			(justify left bottom)
		)
		(uuid "3cba8bfe-55a9-5609-bf7f-2c654ca07839")
	)
	(text "wake-on-motion: open-drain active-low, 100k pull-up. INT2 not wired (pin map). VDD 0.1 uF + 2.2 uF X7R, VDDIO 10 nF X7R (table 10)."
		(exclude_from_sim no)
		(at 15.24 83.82 0)
		(effects
