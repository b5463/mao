	(text "CORE 3V3 BUCK"
		(exclude_from_sim no)
		(at 203.2 119.38 0)
		(effects
			(font (size 1.524 1.524) (bold yes))
			(justify left bottom)
		)
		(uuid "1116b8b5-7489-5085-be53-ebe44f997463")
	)
	(text "TPS62840 from REG_IN (= VSYS through LINK_REG R122): 750 mA, 60 nA Iq, PFM (MODE low), STOP low, EN to VIN."
		(exclude_from_sim no)
		(at 203.2 170.18 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "17bf3334-ae6b-5417-b96c-4576d88a9675")
	)
	(text "VSET R111 102k 1 % = 3.2 V (SLVSEC6D table 1, TPS62840: 97.92-106.08k): 0.1 V under the panel VCI 3.3 V"
		(exclude_from_sim no)
		(at 203.2 172.72 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "17536412-65be-5b0a-9de9-31bbfdb8c812")
	)
	(text "maximum. Below ~3.25 V in it runs in 100 % mode (output = input - I x (RDS_on + DCR)). L 2.2 uH"
		(exclude_from_sim no)
		(at 203.2 175.26 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "59ffc9a0-52cd-5179-abfc-2b29e6378f52")
	)
	(text "DFE201612E-2R2M, CIN 4.7 uF, COUT 10 uF; with the loads the +3V3 rail stays under 40 uF effective. No UVLO"
		(exclude_from_sim no)
		(at 203.2 177.8 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "e25bae3c-b976-5e5a-8d2e-d05b40551432")
	)
	(text "divider: the charger's 3.0 V BATFET cut-off and a firmware floor replace it."
		(exclude_from_sim no)
		(at 203.2 180.34 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "5320fc8e-4133-5b42-a428-000eadcb3708")
	)
