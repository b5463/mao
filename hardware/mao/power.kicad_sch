	(text "CHARGER"
		(exclude_from_sim no)
		(at 168.91 24.13 0)
		(effects
			(font (size 1.524 1.524) (bold yes))
			(justify left bottom)
		)
		(uuid "f4f26b15-bdf9-54b6-815d-9eed38eb727e")
	)
	(text "BQ25185 linear charger with power path: runs MAO from USB while charging, SYS 4.5 V on USB. ILIM/VSET R104 18k = 4.2 V, 500 mA input limit (SLUSF65B table 6-1). ISET"
		(exclude_from_sim no)
		(at 168.91 93.98 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "e7038965-92dd-576b-a7b1-418a277fe89e")
	)
	(text "R103 1.43k 1% = 300 AOhm / 1.43k = 210 mA charge (199-220 mA), as A0 (the LP503035 cell allows 250 mA, 0.5C). TS/MR to the cell's 10k NTC (DNP 10k fallback R110); the"
		(exclude_from_sim no)
		(at 168.91 96.52 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "9e85f7c6-b43c-56be-a82d-2cfdc17b3415")
	)
	(text "fixture enters factory (ship) mode by holding TS/MR low 10 s with USB present (TP TSMR). /CE from GPIO18 (CHG_CE_N, 100k pull-down: charging on from reset): firmware"
		(exclude_from_sim no)
		(at 168.91 99.06 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "ecc4c689-0b8f-50d6-a003-2c5d37e9c616")
	)
	(text "pauses charging outside the cell's 0-45 C. STAT1/STAT2 open-drain, 10k pull-ups to +3V3, to GPIO33/34: high-Z on battery, 0 uA. BATFET off below 3.0 V (BUVLO): the"
		(exclude_from_sim no)
		(at 168.91 101.6 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "23b7a86b-8f2d-556d-a669-8c93613158f9")
	)
	(text "hardware floor that replaces A0's UVLO divider. Caps per TI: IN and BAT 2.2 uF 25 V 0402 (>= 1 uF left after DC bias, SLUSF65B 7.2.2.3), SYS 10 uF 25 V."
		(exclude_from_sim no)
		(at 168.91 104.14 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "de720726-b008-5c5f-833f-c7919b98d7d3")
	)
