	(text "3V3 BUCK-BOOST"
		(exclude_from_sim no)
		(at 215.9 118.11 0)
		(effects
			(font (size 1.524 1.524) (bold yes))
			(justify left bottom)
		)
		(uuid "6c1807e1-e10d-520d-a537-578947c4e19f")
	)
	(text "TPS63802: VSYS 2.9-4.4 V to +3V3, 2 A, 11 uA Iq. EN divider = hardware UVLO: on at 3.25 V, off at 2.96 V (protects the cell even if firmware fails),"
		(exclude_from_sim no)
		(at 215.9 180.34 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "d3b98c82-c9a0-5ca1-b44d-4a996a7795c9")
	)
	(text "100 nF so load steps cannot trip it. MODE low = PFM. FB 536k/100k = 3.18 V (3.10-3.28 V worst case: under the panel VCI 3.3 V maximum). L = 0.47 uH"
		(exclude_from_sim no)
		(at 215.9 182.88 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "0eb4a1f5-eb5f-57a3-8ee3-5eaf3c874c1d")
	)
	(text "only."
		(exclude_from_sim no)
		(at 215.9 184.15 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "43a94d3c-548b-5c0e-97a9-050a1b67a714")
	)
