	(text "JST SH 3-pin: 1 = BAT-, 2 = NTC, 3 = BAT+ (same order as KINO J1100, ODD JOBS 41/167). Cell MUST carry its own"
		(exclude_from_sim no)
		(at 15.24 158.75 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "d4e2e71a-11a8-54bc-b24b-228638a810cb")
	)
	(text "protection PCM and a 10k NTC. R108 = 0R link to measure battery current (110). Q101 blocks a reversed cell (51);"
		(exclude_from_sim no)
		(at 15.24 161.29 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "f7e19b9e-1a04-5aa8-88e5-37b976e5609f")
	)
	(text "with USB in, the charger stays in its 4-11 mA short probe. R110 fits only for cells without NTC."
		(exclude_from_sim no)
		(at 15.24 163.83 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
