	(text "3V3 BUCK-BOOST"
		(exclude_from_sim no)
		(at 204.47 104.14 0)
		(effects
			(font (size 1.524 1.524) (bold yes))
			(justify left bottom)
		)
		(uuid "d139a357-569c-590e-8373-1af533afb014")
	)
	(text "TPS63802: VSYS 2.9-4.4 V to +3V3, 2 A, 11 uA Iq. EN divider = hardware UVLO: on at 3.25 V, off at 2.96 V (protects the cell even if firmware"
		(exclude_from_sim no)
		(at 204.47 163.83 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "4e70b796-38ab-5dde-bf70-4041a66962a3")
	)
	(text "fails), 100 nF so load steps cannot trip it. MODE low = PFM. FB 536k/100k = 3.18 V (3.10-3.28 V worst case: under the panel VCI 3.3 V maximum). L"
		(exclude_from_sim no)
		(at 204.47 166.37 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "3b6a7b9b-b1ed-5e02-950b-44943b4cbaa7")
	)
	(text "= 0.47 uH only."
		(exclude_from_sim no)
		(at 204.47 168.91 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "7557e8df-2eea-53ff-986e-40dcf56fe3d7")
	)
