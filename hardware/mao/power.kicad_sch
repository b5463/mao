			(justify left bottom)
		)
		(uuid "7d8fbc5b-1480-5f29-9056-945dbe76008b")
	)
	(text "it. Fixed slew: turn-on about 1.7 ms, 10-90 %% rise about 1.0 ms at 3.18 V, so the ~26 mA panel inrush cannot brown"
		(exclude_from_sim no)
		(at 15.24 226.06 0)
		(effects
