		(uuid "4b7e116d-05c1-5c46-9453-39e2b4ec1089")
	)
	(text "AUX_PWR_EN (GPIO16), through 100R/4.7 uF only while listening (0.4 mA). OUT pull-up goes to the switched supply, never to +3V3, so an unpowered"
		(exclude_from_sim no)
		(at 154.94 166.37 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "ca10c65d-dab8-5078-a679-d7f531438708")
	)
