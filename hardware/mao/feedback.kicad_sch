	(text "shares the always-on rail of the I2C pull-ups and is never supply-gated). VDD pin 10 and VDD/NC pin 6 to +3V3."
		(exclude_from_sim no)
		(at 163.83 74.93 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "41cf27e1-fc9e-5046-bb8e-85b1fe8bf29f")
	)
	(text "I2C 0x5A, EN from GPIO14 with 100k pull-down (4 uA off). IN/TRIG low: playback by I2C. REG 1 uF, VDD 1 uF. LRA"
		(exclude_from_sim no)
		(at 163.83 77.47 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "9ca22e8d-eba2-5a57-90af-66432fcc90a3")
	)
	(text "LD0832AA (235 Hz, 1.8 Vrms) glued to the base, leads to J501."
		(exclude_from_sim no)
		(at 163.83 80.01 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "021f1f4b-111d-5ed3-97d6-927b70a8376f")
	)
