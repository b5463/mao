	(text "Two DRV5012 Hall latches under the ring's 30-pole ferrite strip, 6 deg apart (half a pole = 90 deg electrical): A/B quadrature identical to"
		(exclude_from_sim no)
		(at 15.24 180.34 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "f446fb20-b0e5-57ea-b894-2e6466935427")
	)
	(text "the LCDkit EC11 (2 transitions per detent, 30 detents). HALL_FAST low = 20 Hz sampling, 1.6 uA (sleep); high = 2.5 kHz (awake)."
