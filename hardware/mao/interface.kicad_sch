	(text "edges (ODD JOBS 29). Panel logic on the switched 3V3_LCD rail, backlight anode on VSYS through the constant-current"
		(exclude_from_sim no)
		(at 15.24 96.52 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "dafbe6ec-dce6-5d19-8680-e27b5834b305")
	)
	(text "driver; RST held low until firmware. The stock 70 mm tail lies as one loop under the panel (turning in a 2.4 mm well of"
		(exclude_from_sim no)
		(at 15.24 99.06 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "32337fc6-ca9e-5d86-8cb4-1527c5d3f3bd")
	)
	(text "the face carrier), drops through the board slot at 9 o'clock and plugs into J301 on B.Cu."
