	)
	(text "Two DRV5012 Hall latches under the ring's 30-pole ferrite strip, 6 deg apart (half a pole = 90 deg electrical): A/B quadrature identical to the LCDkit"
		(exclude_from_sim no)
		(at 121.92 93.98 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "0396351e-b1cc-5ff2-840f-58b67e989016")
	)
	(text "EC11 (2 transitions per detent, 30 detents). HALL_A on GPIO21 (RTC: deep-sleep wake, ext0 armed at the opposite level), HALL_B on GPIO37. HALL_FAST"
		(exclude_from_sim no)
		(at 121.92 96.52 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "a15a6bc9-3882-5163-992f-b0cad9f64ab6")
	)
	(text "(GPIO5) low = 20 Hz sampling, 1.3 uA (sleep); high = 2.5 kHz (awake); 100k pull-down."
		(exclude_from_sim no)
		(at 121.92 99.06 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "8ed07d96-9c68-582c-89fd-fc3465b87aa1")
	)
