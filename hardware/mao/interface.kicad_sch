	(text "Constant-current low-side sink from VSYS (Gate C): LCD_BL (GPIO8, LEDC ~30 kHz) -> 32.4k / 1.0k -> BL_REF (0 / 95.8 mV at 3.2"
		(exclude_from_sim no)
		(at 15.24 219.71 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "93db53bd-41b2-5d48-ac0f-b3cf7c7405de")
	)
	(text "V: 3.2 V x 1.0 / 33.4); TLV9061 on 3V3_LCD (0 uA in deep sleep) drives DMG2302UKQ so that BL_SENSE follows BL_REF: Rs 3.3 ohm"
		(exclude_from_sim no)
		(at 15.24 222.25 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "8b0c36d0-b870-5337-917e-67f62f94a752")
	)
	(text "1% = 29.0 mA at 100 % (Gate C 30 mA at 3.3 V). Regulates for VSYS >= Vf (3.4 V max) + 0.1 V. Off from reset: LCD_BL 100k,"
		(exclude_from_sim no)
		(at 15.24 224.79 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "c981e1db-b1ec-5043-a779-9cae4408ff70")
	)
	(text "BL_REF 1.0k, gate 100k to GND, op-amp unpowered with the panel. DNP 100 pF loop compensation (fit if the sink rings). Rs is"
		(exclude_from_sim no)
		(at 15.24 227.33 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "af7bfaa1-ecea-548f-a7bb-00a222497051")
	)
	(text "re-set when Winstar's backlight data arrives."
		(exclude_from_sim no)
		(at 15.24 229.87 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "c7b7b1b7-6fa4-5f10-b338-f6d563ce1f72")
	)
