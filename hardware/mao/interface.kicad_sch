	(text "Constant-current low-side sink from VSYS (Gate C): LCD_BL (GPIO8, LEDC ~30 kHz) -> 32.4k / 1.0k -> BL_REF (0 / 95.8 mV at 3.2"
		(exclude_from_sim no)
		(at 167.64 219.71 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "02531354-c575-5b5f-957c-2b5142e319dc")
	)
	(text "V: 3.2 V x 1.0 / 33.4); TLV9061 on 3V3_LCD (0 uA in deep sleep) drives DMG2302UKQ so that BL_SENSE follows BL_REF: Rs 3.3 ohm"
		(exclude_from_sim no)
		(at 167.64 222.25 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "f040471e-548d-59fb-9fc0-19fdaa30f355")
	)
	(text "1% = 29.0 mA at 100 % (Gate C 30 mA at 3.3 V). Regulates for VSYS >= Vf (3.4 V max) + 0.1 V. Off from reset: LCD_BL 100k,"
		(exclude_from_sim no)
		(at 167.64 224.79 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "7ecb5717-dcb0-54d5-8063-b05ffaf2e1c7")
	)
	(text "BL_REF 1.0k, gate 100k to GND, op-amp unpowered with the panel. DNP 100 pF loop compensation (fit if the sink rings). Rs is"
		(exclude_from_sim no)
		(at 167.64 227.33 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "06b11fa2-1495-5c0d-9151-acb2b89108aa")
	)
	(text "re-set when Winstar's backlight data arrives."
		(exclude_from_sim no)
		(at 167.64 229.87 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
