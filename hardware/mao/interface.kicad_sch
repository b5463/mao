	(text "Panel LEDs (one group of two) need VLED+ 3.0/3.2/3.4 V at 40 mA (Winstar spec"
		(exclude_from_sim no)
		(at 161.29 162.56 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "70ee69b7-fd43-53d3-9e70-e8ed17717d82")
	)
	(text "4.2): more than 3V3 can drive. AW9364 constant-current sinks from VSYS (50 mV"
		(exclude_from_sim no)
		(at 161.29 165.1 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "a8d49938-0c46-5d9b-bf0b-49e4c51407d7")
	)
	(text "typical, 170 mV maximum dropout): LED1+LED2 on VLED- = 2 x 20 mA = 40 mA"
		(exclude_from_sim no)
		(at 161.29 167.64 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "044fe3ea-eed1-51ad-9b26-4e8812aed7dc")
	)
	(text "nominal (33-47 mA: +-17.5 % part tolerance), set by the part, not by firmware."
		(exclude_from_sim no)
		(at 161.29 170.18 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "22c32997-a62a-58fc-b54e-9df1ca58b908")
	)
	(text "16 steps by EN pulses on GPIO45; its 150k EN pull-down keeps the panel dark"
		(exclude_from_sim no)
		(at 161.29 172.72 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "68654984-7569-5814-8382-27bbd12dd42a")
	)
	(text "from reset (ODD JOBS 116). Full 40 mA down to VSYS 3.4 V on the typical 3.2 V"
		(exclude_from_sim no)
		(at 161.29 175.26 0)
		(effects
			(font (size 1 1))
			(justify left bottom)
		)
		(uuid "65377157-1778-5e21-b929-141f92d1049e")
	)
	(text "bin, 3.6 V on the 3.4 V bin (sim S3; 0.12 V higher at the maximum dropout);"
