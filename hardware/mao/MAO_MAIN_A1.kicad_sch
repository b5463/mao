	(text "MAO_MAIN A1 - ODD JOBS / MAO round puck main board (A0 moved to the M5 Gate C architecture)"
		(exclude_from_sim no)
		(at 25.4 215.9 0)
		(effects
			(font (size 1.524 1.524))
			(justify left bottom)
		)
		(uuid "58b860e0-ff2b-59b4-8b9f-adb975edf8ba")
	)
	(text "GPIO0 = BOOT strap only: 10k pull-up and test pad TP8 BOOT (Tag-Connect pin 6). Hold TP8 low during a reset (TP7 RST, Tag-Connect pin 2, or USB with no cell) to enter download mode. The face press is GPIO1, not a strap."
		(exclude_from_sim no)
		(at 25.4 219.71 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "aa6f9b1c-7ccb-5688-9660-11814bbccf9f")
	)
	(text "GPIO45 (VDD_SPI strap) and GPIO46 are NC with their internal pull-downs: nothing may pull GPIO45 high (VDD_SPI 1.8 V would stop the 3.3 V flash). GPIO3 (JTAG-source strap) is NC."
		(exclude_from_sim no)
		(at 25.4 223.52 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "7c2fa7d2-64a4-5504-af17-3566a6372637")
	)
	(text "Every enable has a hardware pull-down and sits on a pin without a reset pull (pinmap.py rules): all off at reset."
		(exclude_from_sim no)
		(at 25.4 227.33 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "787419fb-aa36-5fc2-9a1e-6b9d58af4ba1")
	)
