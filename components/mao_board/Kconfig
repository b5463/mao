menu "MAO board"

    choice MAO_BOARD
        prompt "Board"
        default MAO_BOARD_LCDKIT if IDF_TARGET_ESP32C3
        default MAO_BOARD_MAIN_A1 if IDF_TARGET_ESP32S3
        help
            The hardware MAO runs on. Each board belongs to one chip, so the
            target (the tools/idf.ps1 profile) picks the matching board.

        config MAO_BOARD_LCDKIT
            bool "ESP32-C3-LCDkit (Espressif development kit)"
            depends on IDF_TARGET_ESP32C3

        config MAO_BOARD_MAIN_A1
            bool "MAO_MAIN A1 (ESP32-S3-MINI-1-N8)"
            depends on IDF_TARGET_ESP32S3
    endchoice

    choice MAO_A1_LCD_ROTATION
        prompt "MAO_MAIN A1: display rotation"
        depends on MAO_BOARD_MAIN_A1
        default MAO_A1_LCD_ROTATION_90
        help
            How the round panel is turned in the puck relative to the LCDkit
            mounting (FPC tail towards 6 o'clock), in clockwise degrees. The
            panel tail leaves at 9 o'clock (as on the A0), a 90 degree turn,
            hence the default.

            VERIFY AT BRING-UP: the direction of that turn as seen by the
            controller is not known until the face is on screen. If the eyes
            appear rotated, try 270 live with "mao rotate 270" (dev console),
            then "mao rotate save" or fix it here.

        config MAO_A1_LCD_ROTATION_0
            bool "0 (as on the LCDkit)"
        config MAO_A1_LCD_ROTATION_90
            bool "90"
        config MAO_A1_LCD_ROTATION_180
            bool "180"
        config MAO_A1_LCD_ROTATION_270
            bool "270"
    endchoice

    config MAO_A1_LCD_ROTATION_DEG
        int
        default 0 if MAO_A1_LCD_ROTATION_0
        default 90 if MAO_A1_LCD_ROTATION_90
        default 180 if MAO_A1_LCD_ROTATION_180
        default 270 if MAO_A1_LCD_ROTATION_270
        default 0

    config MAO_A1_LCD_PCLK_MHZ
        int "MAO_MAIN A1: display SPI clock (MHz)"
        depends on MAO_BOARD_MAIN_A1
        range 10 80
        default 80
        help
            The GC9A01 SPI clock (SPI2 on its IO_MUX pads). VERIFY AT
            BRING-UP: run the colour test and the animation at 80 MHz; if lines
            tear or pixels go wrong, set 40 here. Use 80 or 40: the SPI clock
            divides 80 MHz, so other values round to a neighbouring 80/n.

    # Not user-editable: the name always follows the board choice.
    config MAO_BOARD_NAME
        string
        default "ESP32-C3-LCDkit" if MAO_BOARD_LCDKIT
        default "MAO_MAIN A1" if MAO_BOARD_MAIN_A1
        default "unsupported"

endmenu
